{
  "name": "weather",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "eslint app src --ignore-pattern '**/__tests__/**' --max-warnings=0",
    "lint:fix": "eslint app src --ignore-pattern '**/__tests__/**' --fix --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc --noEmit",
    "test": "pnpm test:unit && pnpm test:integration",
    "test:unit": "jest --config jest.config.unit.js",
    "test:integration": "jest --config jest.config.integration.js",
    "test:unit:ci": "mkdir -p test-results/jest && jest --config jest.config.unit.js --coverage --ci --maxWorkers=2 --json --outputFile=test-results/jest/results.json",
    "test:integration:ci": "jest --config jest.config.integration.js --coverage --ci --maxWorkers=2",
    "test:watch": "pnpm test:unit -- --watch",
    "test:coverage": "pnpm test:unit -- --coverage",
    "test:mutation": "stryker run",
    "test:e2e:web": "playwright test",
    "test:e2e:mobile": "maestro test .maestro/",
    "ci:slow-tests": "node scripts/ci-test-observability.mjs --top 10",
    "check:unused": "knip --no-config-hints",
    "check:updates": "pnpm dlx npm-check-updates",
    "check:all": "pnpm lint && pnpm type-check && pnpm format:check && pnpm test && pnpm check:unused && pnpm check:import-meta",
    "check:all-short": "echo '=== lint ===' && eslint app src --ignore-pattern '**/__tests__/**' --max-warnings=0 --quiet && echo '=== type ===' && tsc --noEmit && echo '=== format ===' && prettier --check . --log-level error && echo '=== test ===' && pnpm test:unit -- --silent --no-coverage 2>&1 | tail -3 && echo '=== unused ===' && knip && echo '=== import-meta ===' && node scripts/scan-prod-deps.js",
    "check:bundle": "bash scripts/bundle-scan.sh",
    "check:import-meta": "node scripts/scan-prod-deps.js",
    "check:security": "bash scripts/security-check.sh",
    "check:security:strict": "bash scripts/security-check.sh --strict",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix --max-warnings=0",
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@expo/vector-icons": "~15.1.1",
    "@react-native-async-storage/async-storage": "3.0.1",
    "@tanstack/query-async-storage-persister": "^5.90.24",
    "@tanstack/react-query": "^5.90.21",
    "@tanstack/react-query-persist-client": "^5.90.24",
    "expo": "~55.0.5",
    "expo-location": "~55.1.2",
    "expo-router": "~55.0.4",
    "expo-status-bar": "~55.0.4",
    "expo-system-ui": "~55.0.9",
    "nativewind": "5.0.0-preview.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-native": "0.84.1",
    "react-native-css": "^3.0.4",
    "react-native-reanimated": "4.2.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.24.0",
    "react-native-svg": "^15.15.3",
    "react-native-web": "^0.21.2",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.4.3",
    "@commitlint/config-conventional": "^20.4.3",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.58.2",
    "@stryker-mutator/core": "^9.3.0",
    "@stryker-mutator/jest-runner": "^9.3.0",
    "@tailwindcss/postcss": "^4.2.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "~19.2.14",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "babel-jest": "^29.7.0",
    "babel-plugin-transform-define": "^2.1.4",
    "babel-plugin-transform-import-meta": "^2.3.3",
    "commitlint": "^20.4.3",
    "eslint": "^10.0.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.16.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^17.4.0",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "jest-expo": "^55.0.9",
    "knip": "^5.86.0",
    "lint-staged": "^16.3.2",
    "msw": "^2.12.10",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.2.1",
    "ts-jest": "^29.4.6",
    "typescript": "~5.9.3"
  },
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "pnpm": {
    "overrides": {
      "react": "19.2.4",
      "react-dom": "19.2.4",
      "react-test-renderer": "19.2.4",
      "jsdom": "^26.1.0"
    },
    "onlyBuiltDependencies": [
      "msw"
    ]
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=10"
  }
}
