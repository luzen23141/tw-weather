# 天氣 API Keys
CWA_API_KEY=your_cwa_api_key
WEATHERAPI_KEY=your_weatherapi_key
OPENWEATHERMAP_KEY=your_openweathermap_key

# 伺服器設定
PORT=8080

# HMAC 簽名 secret（留空則跳過驗證，適用開發環境）
# 建議長度 >= 32 字元
PROXY_SECRET=

# 上游端點覆寫（留空使用官方託管服務）
#
# Open-Meteo 官方免費層禁止商業用途，但軟體為 AGPLv3、資料為 CC BY 4.0，
# 自架後暴露同一組 API。正式環境指向自架實例即可，不需改動程式碼。
# 自架方式：https://github.com/open-meteo/open-meteo
OPENMETEO_FORECAST_URL=
OPENMETEO_ARCHIVE_URL=

# 自架時必填：指定要查詢的模式（如 ecmwf_ifs025 / dwd_icon / ncep_gfs013）。
#
# 留空時上游以 best_match 自行挑選。官方託管服務所有模式的資料都在，best_match
# 一定有解；但自架實例只有你同步過的模式，best_match 會挑到沒資料的模式，
# 導致回應的每個欄位都變 null（不是只有缺的那個）。
OPENMETEO_MODEL=

# Redis 快取（留空則使用行程內的記憶體快取）
#
# 目的是避免重複呼叫有配額限制的三方 API。記憶體快取重啟即失、也無法跨實例共用。
# 本地開發：docker-compose up -d
REDIS_URL=
REDIS_TTL_SECONDS=300
